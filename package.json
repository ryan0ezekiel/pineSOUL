{
  "name": "pinesoul",
  "version": "1.1.5",
  "description": "Modern Pinecil V2 controller — soul of your soldering iron",
  "main": "electron/main.js",
  "author": "niflheimr <niflheimr@users.noreply.github.com>",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "vite:dev": "vite",
    "electron:dev": "electron .",
    "build": "vite build",
    "preview:web": "vite preview",
    "dev:pwa": "vite --config vite.config.pwa.js",
    "build:pwa": "vite build --config vite.config.pwa.js",
    "preview:pwa": "vite preview --config vite.config.pwa.js",
    "dist:linux": "vite build && electron-builder --linux",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:all": "vite build && electron-builder -wml",
    "postinstall": "electron-builder install-app-deps || true"
  },
  "build": {
    "appId": "com.pinesoul.app",
    "productName": "pineSOUL",
    "copyright": "Copyright © 2026 niflheimr",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "asarUnpack": [
      "node_modules/@abandonware/noble/**"
    ],
    "extraResources": [],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.xz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}.${ext}",
      "desktop": {
        "Name": "pineSOUL",
        "Comment": "Modern Pinecil V2 soldering iron controller",
        "Categories": "Utility;Electronics;",
        "Keywords": "soldering;pinecil;bluetooth;temperature"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "pineSOUL"
    }
  },
  "dependencies": {
    "@abandonware/noble": "^1.9.2-10",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
